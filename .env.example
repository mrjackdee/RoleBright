# Private single-user application authentication
APP_SESSION_SECRET=
ALLOWED_LOGIN_EMAIL=jackdee.sync@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional break-glass override. Normally populated automatically by Google sign-in and stored encrypted in Drive.
GOOGLE_USER_REFRESH_TOKEN=
NOTIFICATION_EMAIL=jackdee.sync@gmail.com

# Google Drive storage. Normal reads/writes run as the allowed Google user.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_MASTER_FOLDER_ID=
GOOGLE_APPLICATION_PACKAGES_FOLDER_ID=
GOOGLE_APPLIED_FOLDER_ID=
GOOGLE_INTERVIEWING_FOLDER_ID=
GOOGLE_OFFERS_FOLDER_ID=
GOOGLE_CLOSED_FOLDER_ID=
GOOGLE_ARCHIVE_FOLDER_ID=

# Service account is used only to read the encrypted user refresh-token bootstrap file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Vercel AI Gateway
AI_MODEL=openai/gpt-5.6-sol
AI_GATEWAY_API_KEY=

# Optional job discovery providers
SERPAPI_KEY=
RAPIDAPI_JSEARCH_KEY=

# Scheduled search protection
CRON_SECRET=
JOB_SEARCH_APP_URL=

# Local development only
USE_LOCAL_STATE=true

# Set only on the isolated test website; omit on production.
# APP_ENV=staging
# Staging-only Cloudflare Access configuration (non-secret identifiers)
# CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-staging-application-audience
