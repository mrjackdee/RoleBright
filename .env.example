# Private single-user application authentication
APP_SESSION_SECRET=
ALLOWED_LOGIN_EMAIL=jackdee.sync@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional break-glass override. Normally populated automatically by Google sign-in and stored encrypted in Drive.
GOOGLE_USER_REFRESH_TOKEN=
NOTIFICATION_EMAIL=jackdee.sync@gmail.com

# Google Drive storage. Normal reads/writes run as the allowed Google user.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_MASTER_FOLDER_ID=
GOOGLE_APPLICATION_PACKAGES_FOLDER_ID=
GOOGLE_APPLIED_FOLDER_ID=
GOOGLE_INTERVIEWING_FOLDER_ID=
GOOGLE_OFFERS_FOLDER_ID=
GOOGLE_CLOSED_FOLDER_ID=
GOOGLE_ARCHIVE_FOLDER_ID=

# Service account is used only to read the encrypted user refresh-token bootstrap file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Vercel AI Gateway
AI_MODEL=openai/gpt-5.6-sol
AI_GATEWAY_API_KEY=

# Optional job discovery providers
SERPAPI_KEY=
RAPIDAPI_JSEARCH_KEY=

# Scheduled search protection
CRON_SECRET=
JOB_SEARCH_APP_URL=

# Local development only
USE_LOCAL_STATE=true

# Staging isolation value only. Production MySQL requires its own explicit mode below.
# APP_ENV=staging
# Staging-only Cloudflare Access configuration (non-secret identifiers)
# CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-staging-application-audience

# Dedicated staging DB only. Configure securely on staging after provisioning approval.
# APP_ENV=staging
# STAGING_STORAGE=mysql
# Certificate-matching DNS hostname required; IP literals are rejected.
# DB_HOST=
# DB_PORT=3306
# DB_NAME=rolebright_staging
# DB_USER=
# DB_PASSWORD=
# DB_TLS=required
# Optional PEM CA certificate when the provider requires a private CA:
# DB_CA=

# Production state adapter: opt-in only after separate schema/data/cutover approval.
# Do not copy this file wholesale into hosting; USE_LOCAL_STATE=true above is local-only.
# APP_ENV=production
# PRODUCTION_STORAGE=mysql
# PROD_DB_HOST=
# PROD_DB_PORT=3306
# PROD_DB_NAME=u761630263_rb_prod
# PROD_DB_USER=u761630263_rb_prodapp
# PROD_DB_PASSWORD=
# PROD_DB_TLS=required
# PROD_DB_CA=
# Privileged schema setup credentials/flags MUST NOT be configured on the app.
# See docs/production-database.md for the separate operator module contract.
